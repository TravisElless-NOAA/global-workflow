#PBS -S /bin/bash
#PBS -N enkfgdas_fcst_%CYC%_mem%ENSMEM%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:30:00
#PBS -l select=8:mpiprocs=128:ompthreads=1:ncpus=128
#PBS -l place=vscatter:exclhost
#PBS -l debug=true

model=gfs
export cyc="%CYC%"
%include <head.h>
%include <envir-p1.h>

############################################################
# Load modules
############################################################
module load PrgEnv-intel/${PrgEnv_intel_ver}
module load craype/${craype_ver}
module load intel/${intel_ver}
module load cray-mpich/${cray_mpich_ver}
module load cray-pals/${cray_pals_ver}
module load libpng/${libpng_ver}
module load hdf5-D/${hdf5_ver}
module load netcdf-D/${netcdf_ver}
module load pnetcdf-D/${pnetcdf_ver}
module load cfp/${cfp_ver}
module load libjpeg/${libjpeg_ver}
module load python/${python_ver}
module load ve/gfs/${ve_gfs_ver}
module load craype-network-ucx
module load cray-mpich-ucx

module list
############################################################
# CALL executable job script here
############################################################
export HOMEglobal=${HOMEgfs}
export WGF="%WGF%"
export ENSMEM="%ENSMEM%"
export MEMDIR="%MEMDIR%"

${HOMEgfs}/jobs/JGLOBAL_FCST
if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

TASK enkfgdas_fcst_master

PURPOSE: EnKF ensemble member forecast -- runs 9-hour coupled UFS for a single
ensemble member. 8 nodes per member. Per-member _master template (80
members).

TROUBLESHOOTING

Same UFS model as deterministic but lower resolution and without wave coupling. 
If a single member or a few members fail, the recovery strategy 
is to copy the entire contents of a successful member from COM 
(ie. enkfgdas.${PDY}/${CYC}/mem${MEM}/*) to the failed member. 

If all enkf forecast members fail,  it is possible that upstream analysis 
might be the cause, but we can also look to decrease the model 
forecast time steps. 

ACTIONS FOR INSTABILITY:

A. ATMOSPHERIC MODEL INSTABILITY:
If log files indicate the atmosphere is blowing up due to numerical instability in the atmospheric model (see item 1 above), try reducing the atmospheric time step proportionally and restart.
To modify, export the following in job card:
     export DELTIM=150

B. OCEAN MODEL INSTABILITY (MOM6):
If the logfile shows "btstep: eta has dropped below bathyT" warnings or ocean CFL crashes, mitigate this by reducing the ocean thermal/dynamics step.
To reduce the time step values from 1800 to 900, export the following in job card:
     export OCNTIM=900
     export DT_THERM_MOM6='900'

%end
